# Copiar a .env y completar. NUNCA subir el .env al repositorio.

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Proxies propios delante de Django. Define de dónde se toma la IP real del
# cliente (auditoría y límite de peticiones). 0 en desarrollo: no hay proxy.
NUM_PROXIES=0

# ---------- Base de datos ----------
# Si el 5432 está ocupado (por ejemplo, por un PostgreSQL instalado en la
# máquina), cambiar POSTGRES_PORT y usar el mismo puerto en DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://inmobiliaria:inmobiliaria@localhost:5432/inmobiliaria
POSTGRES_DB=inmobiliaria
POSTGRES_USER=inmobiliaria
POSTGRES_PASSWORD=inmobiliaria

# Usuario de solo lectura para Power BI (esquema bi)
POWERBI_DB_USER=powerbi_reader
POWERBI_DB_PASSWORD=

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://inmobiliaria:inmobiliaria@localhost:5672//
RABBITMQ_DEFAULT_USER=inmobiliaria
RABBITMQ_DEFAULT_PASS=inmobiliaria

# ---------- Redis ----------
# No se usa por ahora: Celery usa RabbitMQ como broker y no hay backend de
# resultados. Descomentar solo si se agrega cache, con su spec correspondiente.
# REDIS_URL=redis://localhost:6379/0

# ---------- JWT ----------
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# ---------- Agente de IA ----------
# Gemini, capa gratuita. La llave se obtiene en https://aistudio.google.com/
# ADVERTENCIA: en la capa gratuita el contenido enviado se usa para mejorar los
# productos de Google. No enviar datos personales reales.
IA_PROVEEDOR=gemini
IA_API_KEY=
# Confirmar los identificadores exactos y la dimensión del modelo de embeddings
# en Google AI Studio al obtener la llave: cambian entre versiones.
IA_MODELO=gemini-3.5-flash-lite
IA_MODELO_EMBEDDINGS=gemini-embedding-001
# Debe coincidir con la dimensión del campo vector en FragmentoRAG.
# Cambiarla obliga a reindexar todos los documentos.
IA_DIMENSION_EMBEDDINGS=768
IA_MAX_TOKENS_RESPUESTA=1024
# Distancia de coseno máxima para que un fragmento cuente como relevante.
IA_DISTANCIA_MAXIMA=0.42

# ---------- Correo ----------
# Gmail con contraseña de aplicación (requiere verificación en dos pasos
# activada en la cuenta). Generarla en: https://myaccount.google.com/apppasswords
# NO es la contraseña normal de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=cuenta-del-proyecto@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_REMITENTE=Inmobiliaria <cuenta-del-proyecto@gmail.com>

# ---------- Almacenamiento de documentos ----------
# "local" guarda en backend/media/ (desarrollo y pruebas). "s3" usa el bucket
# privado de Supabase Storage (producción). Detalle en specs/011, §6.
STORAGE_BACKEND=local
# Solo con STORAGE_BACKEND=s3: https://<proyecto>.supabase.co/storage/v1/s3
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ---------- CORS ----------
# En producción: la URL del frontend en Vercel, sin barra final
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Producción (Render, Neon y CloudAMQP) ----------
# Se cargan en el panel del servicio web de Render, NUNCA en este archivo.
# Detalle en specs/002-despliegue.md §5.1.
#
#   DJANGO_SETTINGS_MODULE=config.settings.prod
#   SECRET_KEY=<clave aleatoria, distinta de la de desarrollo>
#   DATABASE_URL=<cadena de conexión directa de Neon, con sslmode=require>
#   RABBITMQ_URL=<URL amqps:// de CloudAMQP>
#   CORS_ALLOWED_ORIGINS=https://<proyecto>.vercel.app
#   NUM_PROXIES=3
#   DJANGO_SUPERUSER_EMAIL=<correo del administrador inicial>
#   DJANGO_SUPERUSER_NOMBRE_COMPLETO=<nombre del administrador inicial>
#   DJANGO_SUPERUSER_PASSWORD=<contraseña del administrador inicial>
#   DEMO_AGENTES_PASSWORD=<opcional: contraseña de los agentes de demostración;
#     sin ella no pueden iniciar sesión (spec 004)>
#   CARGAR_DATOS_DEMO=true
#
# ALLOWED_HOSTS no hace falta: prod.py agrega el dominio que Render expone en
# RENDER_EXTERNAL_HOSTNAME.

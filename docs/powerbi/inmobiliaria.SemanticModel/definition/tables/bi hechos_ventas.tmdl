table 'bi hechos_ventas'
	lineageTag: 9ed99d0c-cf25-4228-8239-23b64189fe2b

	/// Venta neta en dólares, con la tasa guardada al firmar.
	measure 'Ventas USD' = SUM('bi hechos_ventas'[neto_usd])
		formatString: "US$" #,0.00
		displayFolder: Indicadores comerciales
		lineageTag: 84a7eea4-ace5-4088-ab00-32a00c1df6e8

	/// Cantidad de contratos no anulados dentro del filtro.
	measure Contratos = COUNTROWS('bi hechos_ventas')
		formatString: #,0
		displayFolder: Indicadores comerciales
		lineageTag: 3b8eeed7-01b2-4b49-9e31-a6d2b338e268

	/// Venta media por contrato dentro del filtro; vacío si no hay contratos.
	measure 'Ticket promedio USD' = DIVIDE([Ventas USD], [Contratos])
		formatString: "US$" #,0.00
		displayFolder: Indicadores comerciales
		lineageTag: 4259e3f2-066e-4f89-96ce-f61d162a8d16


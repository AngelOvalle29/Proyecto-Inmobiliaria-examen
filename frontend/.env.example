# Copiar a .env.local para desarrollo.
#
# ADVERTENCIA: Vite incrusta en el código compilado TODA variable que empiece
# con VITE_. Cualquiera puede leerlas desde el navegador. Nunca poner aquí
# llaves de API, contraseñas ni secretos de ningún tipo.

VITE_API_URL=http://localhost:8000/api/v1
VITE_ENTORNO=desarrollo

# En Vercel se configura, en el panel del proyecto:
# VITE_API_URL=https://<proyecto>.up.railway.app/api/v1
# VITE_ENTORNO=produccion

  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
